# Ejemplo de variables para producción (Render). En local no hace falta ninguna.
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=agrotech-campo-ciudad.onrender.com
CORS_ALLOWED_ORIGINS=https://agrotech-campo-ciudad-qfzf-kq9jtt1qu-estebanfrms-projects.vercel.app
CSRF_TRUSTED_ORIGINS=https://agrotech-campo-ciudad.onrender.com,https://agrotech-campo-ciudad-qfzf-kq9jtt1qu-estebanfrms-projects.vercel.app
CORS_ALLOW_CREDENTIALS=True
DATABASE_URL=postgres://user:password@host:5432/dbname
# Por defecto se exige SSL hacia la base de datos cuando DEBUG=False.
DATABASE_SSL_REQUIRE=True
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
# Administrador creado/actualizado en cada arranque con `python manage.py ensure_admin`.
ADMIN_EMAIL=admin@tu-dominio.com
ADMIN_PASSWORD=una-clave-larga-y-secreta
# Sirve las imágenes subidas desde Django (el disco de Render no es persistente).
SERVE_MEDIA=True
# Límite de intentos de login/registro por IP.
AUTH_THROTTLE_RATE=20/min
